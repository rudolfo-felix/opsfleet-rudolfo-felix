# ==============================================================================
# Opsfleet Retail Data Analysis Assistant — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Studio Configuration (Required)
# ------------------------------------------------------------------------------
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Family Selection (Vlad Bondarenko Directive: configurable, free tier only)
# Supported options:
#   - gemini-2.5-flash      (Default, highest SQL precision on multi-table joins)
#   - gemini-2.5-flash-lite (Ultra-fast, lowest latency)
#   - gemini-3.1-flash      (Advanced thinking & temporal reasoning)
#   - gemini-3.1-flash-lite (High-throughput lightweight)
# Note: gemini-1.5 is retired; gemini-pro requires paid billing.
MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Google Cloud BigQuery & Offline Mock Strategy
# ------------------------------------------------------------------------------
# Google Cloud project ID for BigQuery public dataset
GCP_PROJECT_ID=bigquery-public-data

# Set to true to force offline in-memory DuckDB engine with synthetic fixtures.
# When false (default), the client connects to live BigQuery if GCP ADC is present,
# and automatically falls back to DuckDB if credentials are missing.
MOCK_BIGQUERY=false

# ------------------------------------------------------------------------------
# 3. FinOps & Operational Call Budgets
# ------------------------------------------------------------------------------
# Maximum LLM calls allowed per user question (Vlad guidance: 2-5 calls)
MAX_LLM_CALLS_PER_QUERY=5

# Maximum self-correction SQL retries allowed (Circuit Breaker: <= 2)
MAX_SQL_RETRIES=2

# Rate limit exponential backoff settings for HTTP 429
BACKOFF_MAX_RETRIES=3
BACKOFF_INITIAL_DELAY=1.0
BACKOFF_FACTOR=2.0
BACKOFF_JITTER=true

# ------------------------------------------------------------------------------
# 4. Storage & Observability
# ------------------------------------------------------------------------------
# SQLite database path for saved reports
STORAGE_DB_PATH=reports.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional OpenTelemetry / Langfuse Tracing
OTEL_ENABLED=false
